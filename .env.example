# Copy to .env and fill in. .env is gitignored.

# Nebius Token Factory, for Nemotron inference.
NEBIUS_API_KEY=

# Exact Nemotron model IDs. Once the key is set, run `loadbearing models`
# and paste the IDs it prints.
NEMOTRON_NANO_MODEL=
NEMOTRON_SUPER_MODEL=
NEMOTRON_ULTRA_MODEL=

# Tavily, for fetching a pipeline's intended behaviour from upstream docs.
TAVILY_API_KEY=

# Sandboxes credentials are not read from this file. Run `contree auth` once;
# it picks up NEBIUS_API_KEY and NEBIUS_AI_PROJECT from the environment and
# saves a profile the sandbox backend uses.
NEBIUS_AI_PROJECT=
