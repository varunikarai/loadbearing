# Copy to .env and fill in. .env is gitignored.

# Nebius Token Factory, for Nemotron inference.
NEBIUS_API_KEY=

# Exact Nemotron model IDs. Once the key is set, run `loadbearing models`
# and paste the IDs it prints.
NEMOTRON_NANO_MODEL=
NEMOTRON_SUPER_MODEL=
NEMOTRON_ULTRA_MODEL=

# Tavily, for fetching a pipeline's intended behaviour from upstream docs.
TAVILY_API_KEY=

# Nebius project for Token Factory Sandboxes. contree-sdk reads this and
# NEBIUS_API_KEY from the environment; loadbearing loads both from this file.
# Alternatively run `contree auth` once (uv tool install contree-cli): the SDK
# also reads the profile it saves. That CLI names this NEBIUS_AI_PROJECT.
NEBIUS_PROJECT_ID=
